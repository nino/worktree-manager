{
  "name": "worktree-manager",
  "version": "1.0.0",
  "description": "Manage git worktrees across repositories",
  "main": "./out/main/index.js",
  "author": "nino@ninoan.com",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "build": "pnpm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dist": "pnpm build && electron-builder --mac --publish never --config electron-builder.yml",
    "install-app": "node scripts/install.mjs",
    "bake-grain": "node scripts/bake-grain.mjs",
    "screenshot": "electron-vite build && node scripts/screenshot.mjs"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.102.8",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "electron-vite": "^5.0.0",
    "happy-dom": "^20.13.2",
    "lucide-react": "^1.40.0",
    "playwright-core": "^1.62.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
