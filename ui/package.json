{
  "name": "worktree-manager-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun --bun tsc --noEmit && bun --bun vite build",
    "test": "bun --bun vitest run",
    "check": "bun --bun tsc --noEmit",
    "tauri": "bun --bun tauri",
    "app": "cd .. && bun --bun ui/node_modules/.bin/tauri dev -- --no-default-features"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "solid-js": "1.9.17"
  },
  "devDependencies": {
    "@solidjs/testing-library": "0.8.10",
    "@tauri-apps/cli": "2.12.3",
    "jsdom": "29.1.1",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-solid": "2.11.14",
    "vitest": "5.0.5"
  },
  "packageManager": "bun@1.4.2"
}
